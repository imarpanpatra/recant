# FalkorDB Cloud gives you a connection string like:
#   falkordb://falkordb:<password>@<host>.falkordb.io:<port>
# Use falkors:// (or set FALKORDB_TLS=true) for TLS-enabled instances.
FALKORDB_URL=
FALKORDB_TLS=false

# Or point at a local instance instead of using FALKORDB_URL:
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

FALKORDB_GRAPH=recant

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

PORT=8080
