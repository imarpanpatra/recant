# FalkorDB Cloud: take the endpoint and port from your instance's Connect
# dialog, and percent-encode any reserved characters in the password
# ($ -> %24, @ -> %40), or the URL parser will split it in the wrong place.
#   falkor://falkordb:<password>@<endpoint>.cloud:<port>
# Free-tier instances are plain TCP. Use falkors:// (or FALKORDB_TLS=true)
# only if your instance has TLS enabled.
FALKORDB_URL=
FALKORDB_TLS=false

# Or point at a local instance instead of using FALKORDB_URL:
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

FALKORDB_GRAPH=recant

# Google AI Studio key: https://aistudio.google.com/apikey
# Leave GEMINI_MODEL unset unless you need to pin one: the client probes a
# list of current models, because Google retires model ids for new keys.
GEMINI_API_KEY=
# GEMINI_MODEL=

PORT=8080
